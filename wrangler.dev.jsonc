{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "v3-dev",
	"main": "worker/dev.ts",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "dev.golabau.com", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"run_worker_first": true
	},
	"vars": {
		"APP_ENV": "development",
		"AUTH_URL": "https://dev.golabau.com"
	},
	"triggers": { "crons": [] },
	"kv_namespaces": [{ "binding": "GOLABAU_CACHE", "id": "f6c433b66a334d79a10e01293ca609b8" }],
	"r2_buckets": [{ "binding": "EVENT_MEDIA", "bucket_name": "golabau-media-dev" }],
	"ratelimits": [
		{
			"name": "ADMIN_LOGIN_RATE_LIMITER",
			"namespace_id": "32001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PUBLIC_WRITE_RATE_LIMITER",
			"namespace_id": "32002",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"observability": { "enabled": true }
}
