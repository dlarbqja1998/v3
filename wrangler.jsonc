{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "v3",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_als"],
	"routes": [
		{
			"pattern": "golabau.com",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"triggers": {
		"crons": ["0 2 * * 1"]
	},
	"kv_namespaces": [
		{
			"binding": "GOLABAU_CACHE",
			"id": "692a6da28f784bf2bf0179a894fda042"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVENT_MEDIA",
			"bucket_name": "golabau-media"
		}
	],
	"ratelimits": [
		{
			"name": "ADMIN_LOGIN_RATE_LIMITER",
			"namespace_id": "31001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PUBLIC_WRITE_RATE_LIMITER",
			"namespace_id": "31002",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
