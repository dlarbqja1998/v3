{
	"name": "v3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "npm run build && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:campus-spots:apply": "tsx scripts/apply-campus-spots-table.ts",
		"db:user-sessions:apply": "tsx scripts/apply-user-sessions-table.ts",
		"db:campus-spots:seed": "tsx scripts/seed-campus-spots.ts",
		"db:campus-events:seed": "wrangler r2 object put golabau-media/events/00000000-0000-4000-8000-000000000001/10000000-0000-4000-8000-000000000001.png --file static/icon.png --content-type image/png --remote && wrangler r2 object put golabau-media/events/00000000-0000-4000-8000-000000000002/10000000-0000-4000-8000-000000000002.png --file static/icon.png --content-type image/png --remote && tsx scripts/seed-campus-events.ts",
		"db:admin:upsert": "tsx scripts/upsert-admin.ts",
		"db:facility-pins:prepare": "tsx scripts/prepare-facility-pins.ts",
		"db:seed": "tsx scripts/seed.ts",
		"naver:local": "tsx scripts/naver-local-search.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.38.0",
		"@neondatabase/serverless": "^1.1.0",
		"cheerio": "^1.2.0",
		"drizzle-orm": "^0.45.2"
	}
}
